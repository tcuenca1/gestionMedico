{
  "expo": {
    "name": "SGMP",
    "slug": "sgmp-movil",
    "version": "1.0.0",
    "scheme": "sgmp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sgmp.movil",
      "infoPlist": {
        "NSCameraUsageDescription": "La app usa la camara para fotografiar examenes de laboratorio.",
        "NSPhotoLibraryUsageDescription": "La app accede a tus fotos para adjuntar examenes de laboratorio."
      }
    },
    "android": {
      "package": "com.sgmp.movil",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": ["expo-router", "expo-image-picker"],
    "extra": {
      "apiUrl": "https://gestionmedico-production-550b.up.railway.app/api",
      "demo": false
    }
  }
}
